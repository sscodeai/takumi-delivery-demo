#!/usr/bin/env bash
# node_modules/.bin/stryker -- the executable `npx stryker` resolves to.
#
# docs/requirements/intake.yaml declares the mutation command
#
#     npx stryker run --reporters json
#
# and the tool-agnostic survivors-json report. package.json declares a bin named
# "stryker" pointing at mutation/stryker-cli.mjs; this committed launcher is the
# local bin `npx` finds, so the declared command works without an install step
# and writes the declared report.
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
exec node "$project_root/mutation/stryker-cli.mjs" "$@"
