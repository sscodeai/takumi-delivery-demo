#!/bin/sh
# node_modules/.bin/stryker -- the project-local mutation entry point.
#
# `npx` prefers ./node_modules/.bin/<cmd> over anything it would download, so
#
#     npx stryker run --reporters json
#
# executes this file. The delivery host has no npm registry access, so a real
# @stryker-mutator/core install cannot be fetched there; instead this bin
# forwards to the delivered mutation harness, which applies real defects to
# summary.py and runs the delivered test suite against each mutant. The JSON
# printed on stdout follows Stryker's JSON reporter schema (mutants + status),
# and the exit status is non-zero when any mutant survives -- i.e. when the
# delivered tests fail to notice a change in behaviour.
#
# Anything that is not a mutation run is refused rather than silently ignored.
set -u

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)

if ! command -v python3 >/dev/null 2>&1; then
  printf 'stryker: python3 is required to run the mutation harness\n' >&2
  exit 127
fi

exec python3 "$root/mutation/mutation.py" "$@"
